#!/usr/bin/env python3

import pathlib
import json
import re

REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent.parent

DECLARED_LICENSE_MD_PATH = REPO_ROOT / "LICENSE"
PACKAGE_JSON_PATH = REPO_ROOT / "package.json"

LICENSES_HTML_PATH = REPO_ROOT / "public" / "licenses.html"
LICENSES_MD_PATH = REPO_ROOT / "LICENSES.md"

licenses_html = LICENSES_HTML_PATH.read_text(encoding="utf-8")
declared_section = re.search(
    r'<section\b[^>]*>\s*<h2\b[^>]*>\s*Declared Licenses\s*</h2>.*?</section>',
    licenses_html,
    re.DOTALL,
)
if declared_section is None:
    raise ValueError("Could not find the Declared Licenses section in the HTML report")
interesting_part_start, interesting_part_end = declared_section.span()
interesting_part = declared_section.group()

license_text = DECLARED_LICENSE_MD_PATH.read_text(encoding="utf-8")
license_copyright_year, license_copyright_holder = re.findall(r'Copyright[^\n]+?(\d{4}(?:-\d{4})?)[^\n]+?(\w+\s\w+)', license_text)[0]
package_json = json.loads(PACKAGE_JSON_PATH.read_text(encoding="utf-8"))
package_declared_license = package_json.get("license", "")
package_name = package_json.get("name", "")
package_version = package_json.get("version", "")

declared_license_html = f"""<div class="license-signature">{package_declared_license}</div>

                    <div class="info-row">
                        <span class="info-label">License Text</span>
                        <div class="license-value">
												<span
                                                        id="declared-{package_name}${package_version}-{package_declared_license}-0-0"
                                                        class="license-text clampable-text clampable-text--clamped-3"
                                                >{license_text}</span>

                            <button
                                    class="text-toggle"
                                    onclick="toggleLicenseText('declared-{package_name}${package_version}-{package_declared_license}-0-0', this)"
                            >
                                Read more
                            </button>
                        </div>
                    </div>

                    <div class="info-row">
                        <span class="info-label">License Header</span>
                        <div class="license-value">
												<span
                                                        id="declared-header-{package_name}${package_version}-0"
                                                        class="license-text clampable-text clampable-text--clamped-3"
                                                >{license_text}</span>

                            <button
                                    class="text-toggle"
                                    onclick="toggleLicenseText('declared-header-{package_name}${package_version}-0', this)"
                            >
                                Read more
                            </button>
                        </div>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Copyright(s)</span>
                        <div class="license-value">
                            <div class="license-copyright">{license_copyright_year} {license_copyright_holder}</div>
                        </div>
                    </div>"""

interesting_part = re.sub(
    r'<div\s+class="license-signature"\s*>\s*No declared licenses found\.\s*</div>',
    lambda match: declared_license_html,
    interesting_part,
)
if f'id="declared-{package_name}${package_version}-{package_declared_license}-0-0"' not in interesting_part:
    raise ValueError("Declared license injection did not produce the expected HTML license entry")

with open(LICENSES_HTML_PATH, "w", encoding="utf-8", newline="\n") as f:
    f.write(licenses_html[:interesting_part_start] + interesting_part + licenses_html[interesting_part_end:])


md_text = LICENSES_MD_PATH.read_text(encoding="utf-8")

declared_license_md = f"""{package_declared_license}

```
{license_text}
```

**License Header:**

```
{license_text}
```"""

md_text = re.sub(
    r'No declared license found for [^\r\n]+',
    lambda match: declared_license_md,
    md_text,
)
with open(LICENSES_MD_PATH, "w", encoding="utf-8", newline="\n") as f:
    f.write(md_text)