{
	"name": "kartkoweczka",
	"license": "MIT",
	"private": true,
	"version": "0.1.0",
	"packageManager": "yarn@4.18.0",
	"type": "module",
	"scripts": {
		"test:scripts": "node --test scripts/*.test.mjs",
		"dev": "vite",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"tauri:android:init": "tauri android init --ci && node scripts/configure-android-insets.mjs",
		"tauri:frontend:dev": "node scripts/run-with-database-backend.mjs yarn vite --host 127.0.0.1 --port 5173 --strictPort",
		"tauri:frontend:build": "node scripts/run-with-database-backend.mjs yarn build",
		"prebuild": "node scripts/generate-sitemap.mjs",
		"build": "vite build",
		"preview": "vite preview --host",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.8.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.3.0",
		"zod-compiler": "^1.27.0"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1",
		"@tauri-apps/api": "^2.8.0",
		"comlink": "^4.4.2",
		"drizzle-orm": "^0.45.2",
		"mathlive": "^0.110.0",
		"quill": "^2.0.3",
		"sv-router": "^0.18.1",
		"trystero": "^0.25.3",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	}
}
