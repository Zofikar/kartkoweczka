{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Kartkóweczka",
	"version": "0.0.0",
	"identifier": "pl.chwalczyk.kartkoweczka",
	"build": {
		"beforeDevCommand": "yarn tauri:frontend:dev",
		"devUrl": "http://127.0.0.1:5173",
		"beforeBuildCommand": "yarn tauri:frontend:build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Kartkóweczka",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"resizable": true
			}
		],
		"security": {
			"csp": null,
			"capabilities": ["main"]
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMzQ4QjhEMTZGMUEyM0UKUldRK292RVdqWXMwdmdLUlZ4WU5XajVEaEFvci9VcHVyZFlqNXN5VTZOeFQrUU83NXF5NVdQd08K",
			"endpoints": [
				"https://github.com/Zofikar/kartkoweczka/releases/latest/download/version_mainfest.json"
			]
		}
	},
	"bundle": {
		"active": true,
		"windows": {
			"nsis": {
				"installerHooks": "windows/installer-hooks.nsh"
			}
		},
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
